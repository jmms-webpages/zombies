# Copy to .env.local and fill in real values. .env.local is gitignored.
# The MVP runs fully offline and does NOT need any of these yet.
#
# Firebase web-app config. These identify your project and are shipped to the
# browser by design; access is controlled by Auth + Firestore security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# WARNING: every VITE_* variable is bundled into frontend code and visible to
# anyone who opens the site. NEVER put a Claude/Anthropic API key (or any other
# secret) in a VITE_* variable. The Claude-backed Game Master must call the API
# from a server-side component instead.
